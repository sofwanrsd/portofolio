# ==========================================================
#  PORTFOLIO CMS — Environment Variables
#  Copy to `.env.local` (lokal) / set di Vercel → Settings → Environment Variables
# ==========================================================

# --- Database (Neon) ---
# Neon Dashboard → Connection Details → "Pooled connection" (untuk runtime Vercel)
# Contoh: postgresql://USER:PASSWORD@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---
# Secret untuk menandatangani session token (JWT). Generate: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-random-string-minimal-32-karakter"

# Kredensial admin pertama (dipakai oleh `npm run db:seed` untuk membuat akun)
ADMIN_EMAIL="admin@domainmu.com"
ADMIN_PASSWORD="ganti-password-ini"

# --- Opsional: kirim email notifikasi (form kontak / inquiry "hire me") ---
# Kosongkan kalau tidak dipakai. Kalau diisi, notifikasi dikirim via Resend.
RESEND_API_KEY=""
CONTACT_TO_EMAIL="admin@domainmu.com"
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# --- Opsional: revalidate endpoint publik ---
REVALIDATE_SECRET="ganti-secret-revalidate"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
